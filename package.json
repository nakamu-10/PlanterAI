{
  "name": "planterai",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "check": "npm test && npm run typecheck && npm run build:site && npm run format:check",
    "test": "npm run test:logic && npm run test:notify && npm run test:daily-light && npm run test:validation",
    "test:logic": "tsx tests/logic.test.ts",
    "test:notify": "tsx tests/notify.test.ts",
    "test:daily-light": "tsx tests/dailyLight.test.ts",
    "test:validation": "tsx tests/validation.test.ts",
    "typecheck": "deno check supabase/functions/ingest-sensor/index.ts supabase/functions/line-webhook/index.ts supabase/functions/weekly-summary/index.ts",
    "build:site": "npm --prefix site run build",
    "format:check": "deno fmt --check supabase/functions supabase/migrations tests"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
