# ローカル開発用の設定例。app/.env としてコピーして使う（.gitignoreで除外済み）。
# 本番ビルド時は Vercel のプロジェクト設定に同名の環境変数を登録する。

# supabase functions serve のURL、または本番の https://<project-ref>.supabase.co/functions/v1
VITE_SUPABASE_FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1

# devices.device_key と同じ値（テスト用は supabase/migrations/20260706000000_init.sql 末尾を参照）
VITE_DEVICE_KEY=dev-test-key-CHANGE-ME
