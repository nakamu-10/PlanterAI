{
  "nodeModulesDir": "auto",
  "fmt": {
    "exclude": [
      "**/node_modules/",
      "**/dist/",
      "**/package-lock.json",
      "deno.lock",
      "archive/",
      "references/",
      "supabase/.temp/"
    ]
  },
  "lint": {
    "exclude": ["**/node_modules/", "**/dist/", "archive/", "references/"],
    "plugins": ["./lint/readability.ts"],
    "rules": {
      "exclude": ["no-import-prefix", "no-window", "no-window-prefix"]
    }
  }
}
